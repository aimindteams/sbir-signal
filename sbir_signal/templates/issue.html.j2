{% extends "base.html.j2" %}
{% block root %}../{% endblock %}
{% block title %}{{ issue.title }}{% endblock %}
{% block description %}{{ issue.intro }}{% endblock %}
{% block canonical %}{{ cfg.SITE_URL }}/issues/{{ issue.slug }}.html{% endblock %}
{% block content %}
<article class="issue">
  <p class="kicker">Weekly issue</p>
  <h1>{{ issue.title }}</h1>
  <p class="lede">{{ issue.intro }}</p>
  <ul class="stats">
    <li><strong>{{ issue.new_count }}</strong> {{ "open" if issue.first_issue else "new" }}</li>
    <li><strong>{{ issue.closing_soon|length }}</strong> closing within 3 weeks</li>
    <li><strong>{{ issue.forecasts|length }}</strong> forecasts</li>
  </ul>

  {% if issue.closing_soon %}
  <section>
    <h2>Closing soon</h2>
    <ul class="deadlines">
      {% for opp in issue.closing_soon %}
      <li><span class="date">{{ opp.deadline|short_date(year) }}</span>
        <span><a href="{{ opp.url }}">{{ opp.title }}</a><br><span class="muted">{{ opp.agency }}</span></span></li>
      {% endfor %}
    </ul>
    {% if issue.more_closing %}<p class="muted">Plus {{ issue.more_closing }} more closing within 3 weeks. <a href="../open.html">See the full list</a>.</p>{% endif %}
  </section>
  {% endif %}

  {% if issue.new_groups %}
  <section>
    <h2>{{ "Open now" if issue.first_issue else "New this week" }}</h2>
    {% for group, items in issue.new_groups %}
    <h3 class="group">{{ group }}</h3>
    {% for opp in items %}
    <div class="card">
      <h4><a href="{{ opp.url }}">{{ opp.title }}</a></h4>
      <p class="meta">{{ meta_line(opp, year) }}</p>
      {% if opp.summary %}<p>{{ opp.summary }}</p>{% endif %}
      {% if opp.funding or opp.facts %}
      <ul class="facts">
        {% for line in opp.funding + opp.facts %}<li>{{ line }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
    {% endfor %}
    {% if issue.more_new %}<p class="muted">Plus {{ issue.more_new }} more new {{ "opportunity" if issue.more_new == 1 else "opportunities" }} with later deadlines. <a href="../open.html">See the full list</a>.</p>{% endif %}
  </section>
  {% endif %}

  {% if issue.forecasts %}
  <section>
    <h2>Coming soon: forecasts and pre-release topics</h2>
    <p class="muted">Announced but not open yet. During pre-release you can email a DoD topic's author directly; once it opens, questions go through DSIP's topic Q&A instead.</p>
    {% for opp in issue.forecasts %}
    <div class="card compact">
      <h4><a href="{{ opp.url }}">{{ opp.title }}</a></h4>
      <p class="meta">{{ meta_line(opp, year) }}</p>
      {% if opp.summary %}<p>{{ opp.summary }}</p>{% endif %}
      {% if opp.facts and opp.facts[0].startswith("Questions before it opens") %}<p class="meta">{{ opp.facts[0] }}</p>{% endif %}
    </div>
    {% endfor %}
    {% if issue.more_forecasts %}<p class="muted">Plus {{ issue.more_forecasts }} more. <a href="../open.html">See the full list</a>.</p>{% endif %}
  </section>
  {% endif %}

  {% if issue.still_open %}
  <section>
    <h2>Still open</h2>
    <p>{{ issue.still_open }} more {{ "opportunity is" if issue.still_open == 1 else "opportunities are" }} still accepting applications. <a href="../open.html">See the full list</a>.</p>
  </section>
  {% endif %}

  <aside class="subscribe">
    <p><strong>Get this every Monday.</strong> Free, one email a week.</p>
    <a class="button" href="{{ cfg.SUBSTACK_URL }}">Subscribe on Substack</a>
  </aside>
</article>
{% endblock %}
